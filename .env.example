COMPOSE_PROJECT_NAME=go-fiber-playground
TZ=UTC

APP_ENV=development
APP_PORT=3000
GO_VERSION=1.27.1

POSTGRES_VERSION=17
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=playground
POSTGRES_PORT=5432
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/playground?sslmode=disable

REDIS_VERSION=7
REDIS_PASSWORD=redis
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL=redis://:redis@localhost:6379/0
